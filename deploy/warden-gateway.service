[Unit]
Description=Warden Gateway
Documentation=https://github.com/tktogether/warden-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/warden-gateway serve --config /etc/warden-gateway/config.json
Restart=always
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=false
ReadWritePaths=/etc/warden-gateway /var/lib/warden-gateway

[Install]
WantedBy=multi-user.target
